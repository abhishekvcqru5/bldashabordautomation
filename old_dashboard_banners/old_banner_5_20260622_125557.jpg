    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const dropdown = document.querySelectorAll('.nav-item.dropdown');

            dropdown.forEach(function (item) {
                item.addEventListener('mouseenter', function () {
                    const toggle = this.querySelector('.dropdown-toggle');
                    const menu = this.querySelector('.dropdown-menu');
                    toggle.classList.add('show');
                    menu.classList.add('show');
                });

                item.addEventListener('mouseleave', function () {
                    const toggle = this.querySelector('.dropdown-toggle');
                    const menu = this.querySelector('.dropdown-menu');
                    toggle.classList.remove('show');
                    menu.classList.remove('show');
                });
            });
        });
    </script>
      <script>
            const scrollAmount = 150;

            function scrollNav(direction, btn) {
                const container = btn.closest('.nav');
                if (!container) return;

                if (direction === "left") {
                    container.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
                } else {
                    container.scrollBy({ left: scrollAmount, behavior: 'smooth' });
                }

                // Delay the update to give time for scroll animation
                setTimeout(() => updateArrowVisibility(container), 300);
            }

            function updateArrowVisibility(container) {
                const leftBtn = container.querySelector('.scroll-arrow.left');
                const rightBtn = container.querySelector('.scroll-arrow.right');

                const scrollLeft = container.scrollLeft;
                const maxScrollLeft = container.scrollWidth - container.clientWidth;

                if (leftBtn)
                    leftBtn.style.display = scrollLeft > 10 ? "inline-block" : "none";
                if (rightBtn)
                    rightBtn.style.display = scrollLeft < maxScrollLeft - 10 ? "inline-block" : "none";
            }

            document.querySelectorAll('.nav').forEach(nav => {
                nav.addEventListener('scroll', () => updateArrowVisibility(nav));
                window.addEventListener('load', () => updateArrowVisibility(nav));
            });
        </script>
             <script>
            const track = document.getElementById("sliderTrack");
            const logos = track.querySelectorAll("img");

            let position = 0;
            let normalSpeed = 0.5;
            let slowSpeed = 0.15;
            let currentSpeed = normalSpeed;
            let isHovering = false;

            function scrollLogos() {
                position -= currentSpeed;
                if (position <= -1980) position = 0;
                track.style.transform = `translateX(${position}px)`;
                requestAnimationFrame(scrollLogos);
            }

            logos.forEach(img => {
                img.addEventListener("mouseenter", () => {
                    isHovering = true;
                    currentSpeed = slowSpeed;
                });

                img.addEventListener("mouseleave", () => {
                    isHovering = false;
                    currentSpeed = normalSpeed;
                });
            });

            scrollLogos();
        </script>

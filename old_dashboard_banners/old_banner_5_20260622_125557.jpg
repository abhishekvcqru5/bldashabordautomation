        <script>
            document.addEventListener("DOMContentLoaded", function () {
                function setupTabHover(tabContainerId) {
                    const container = document.getElementById(tabContainerId);
                    if (!container) return;

                    const navLinks = container.querySelectorAll('.nav-link');

                    navLinks.forEach(link => {
                        link.addEventListener('mouseenter', function () {
                            // Deactivate all links and panes inside this tab section
                            navLinks.forEach(l => l.classList.remove('active', 'show'));

                            // Find all tab panes related to this group
                            const targetPaneIds = Array.from(navLinks).map(l => l.getAttribute('data-bs-target')).filter(id => !!id);
                            const tabPanes = targetPaneIds.map(id => document.querySelector(id)).filter(pane => pane);

                            tabPanes.forEach(pane => pane.classList.remove('active', 'show'));

                            // Activate current link and its target pane
                            this.classList.add('active');
                            const targetId = this.getAttribute('data-bs-target');
                            const targetPane = document.querySelector(targetId);
                            if (targetPane) {
                                targetPane.classList.add('active', 'show');
                            }
                        });
                    });
                }

                setupTabHover('Industries-tab');
                setupTabHover('offering-tab');
            });
        </script>
        <script>
            const playBtn = document.getElementById("playBtn");
            const videoThumb = document.getElementById("videoThumb");
            const mainVideo = document.getElementById("mainVideo");

            let firstPlay = true;

            // ▶ Play when clicking the play button
            playBtn.addEventListener("click", function () {

                if (firstPlay) {
                    videoThumb.style.display = "none";   // remove thumbnail only once
                    mainVideo.style.display = "block";
                    firstPlay = false;
                }

                mainVideo.play();
            });

            // ▶⏸ Toggle Play/Pause when clicking the video frame
            mainVideo.addEventListener("click", function () {
                if (mainVideo.paused) {
                    mainVideo.play();
                } else {
                    mainVideo.pause();
                }
            });
        </script>

    
